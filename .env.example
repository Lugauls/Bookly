# PostgreSQL local
POSTGRES_USER=bookly
POSTGRES_PASSWORD=bookly
POSTGRES_DB=bookly
POSTGRES_PORT=5433
DATABASE_URL=postgresql://bookly:bookly@localhost:5433/bookly?schema=public
SHADOW_DATABASE_URL=postgresql://bookly:bookly@localhost:5433/bookly_shadow?schema=public

# API
API_PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
WEB_URL=http://localhost:5173

# Frontend (somente variáveis com prefixo VITE_ ficam públicas no navegador)
VITE_API_URL=http://localhost:3000
